---
// Shared styles
import "../styles/minimal.css";

// Components
import FooterMinimal from "../components/FooterMinimal.astro";
import NavbarMinimal from "../components/NavbarMinimal.astro";

// Vercel
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  jsonLd?: unknown;
  ogType?: string;
}

const {
  title,
  description,
  image = "/images/adil-al-qaba-og.jpg",
  imageAlt = "Adil Al Qaba",
  imageWidth = 1200,
  imageHeight = 630,
  jsonLd,
  ogType,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const abs = (p: string) => new URL(p, Astro.site).toString();
const isHome = Astro.url.pathname === "/";

const PERSON_ID = "https://www.alqaba.com/#person";
const HEADSHOT_ID = "https://www.alqaba.com/#headshot";

const person = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: "Adil Al Qaba",
  givenName: "Adil",
  familyName: "Al Qaba",
  alternateName: [
    "Adil Al-Qaba",
    "Adil Mohammed Adnan",
    "عادل محمد عدنان",
    "عادل أل قبع",
  ],
  email: "contact@leda.dev",
  jobTitle: "Software Engineer",
  description:
    "Adil Al Qaba is a software engineer and published researcher from Mosul, Iraq, working on robotics, autonomous systems and digital cultural heritage preservation.",
  url: "https://www.alqaba.com",
  mainEntityOfPage: "https://www.alqaba.com",
  nationality: { "@type": "Country", name: "Iraq" },
  image: {
    "@type": "ImageObject",
    "@id": HEADSHOT_ID,
    url: abs("/images/adil-al-qaba.jpg"),
    contentUrl: abs("/images/adil-al-qaba.jpg"),
    width: 800,
    height: 800,
    caption: "Adil Al Qaba",
    creditText: "Adil Al Qaba",
    copyrightNotice: "© Adil Al Qaba",
  },
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Hochschule Bonn-Rhein-Sieg",
    url: "https://www.h-brs.de",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "University of Mosul",
    url: "https://uomosul.edu.iq",
  },
  knowsAbout: [
    "Robotics",
    "Autonomous systems",
    "Cultural heritage preservation",
    "Photogrammetry",
    "Virtual museums",
    "Software engineering",
  ],
  sameAs: [
    "https://www.linkedin.com/in/alqaba",
    "https://github.com/LedaThemis",
    "https://orcid.org/0009-0002-1924-5270",
    "https://scholar.google.com/citations?user=YQ10EnMAAAAJ",
    "https://www.leda.dev",
  ],
};

const site = {
  "@type": "WebSite",
  "@id": "https://www.alqaba.com/#website",
  url: "https://www.alqaba.com",
  name: "Adil Al Qaba",
  inLanguage: "en",
  publisher: { "@id": PERSON_ID },
};

const graph = [
  person,
  site,
  ...(isHome
    ? [
        {
          "@type": "ProfilePage",
          "@id": canonical.toString() + "#page",
          url: canonical.toString(),
          name: title,
          isPartOf: { "@id": "https://www.alqaba.com/#website" },
          about: { "@id": PERSON_ID },
          mainEntity: { "@id": PERSON_ID },
          primaryImageOfPage: { "@id": HEADSHOT_ID },
        },
      ]
    : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];

const ld = { "@context": "https://schema.org", "@graph": graph };
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.ico" /><link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png"
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Adil Al Qaba" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <meta property="og:type" content={ogType ?? (isHome ? "profile" : "website")} />
    <meta property="og:site_name" content="Adil Al Qaba" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={abs(image)} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {isHome && <meta property="profile:first_name" content="Adil" />}
    {isHome && <meta property="profile:last_name" content="Al Qaba" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(image)} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />

    <slot name="head" />

    <SpeedInsights />
  </head>
  <body>
    <NavbarMinimal />
    <slot />
    <FooterMinimal />
  </body>
  <script is:inline defer src="/_vercel/insights/script.js"></script>
  <script is:inline defer src="/stats/script.js" data-website-id="0c8d43bd-455a-40f7-a8e7-72d67dc22ccc"></script>
</html>
