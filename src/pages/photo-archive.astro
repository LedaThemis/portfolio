---
import LayoutMinimal from "../layouts/LayoutMinimal.astro";
import Contact from "../components/Contact.astro";
import { getPhotos, imageObject, SUBJECT } from "../lib/photos";

const photos = await getPhotos();

const lastUpdated = photos.reduce(
  (max, p) => (p.takenISO && p.takenISO > max ? p.takenISO : max),
  "",
);
const lastUpdatedText = new Date(lastUpdated).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const gallery = {
  "@type": "ImageGallery",
  "@id": new URL("/photo-archive", Astro.site).toString() + "#gallery",
  url: new URL("/photo-archive", Astro.site).toString(),
  name: `Photos of ${SUBJECT}`,
  description: `Photographs of ${SUBJECT} at conferences, competitions, interviews and professional events.`,
  about: { "@id": "https://www.alqaba.com/#person" },
  numberOfItems: photos.length,
  associatedMedia: photos.map((p) => imageObject(p, Astro.site)),
};
---

<LayoutMinimal
  title={`Photos of ${SUBJECT} — Photo Archive`}
  description={`${photos.length} photographs of ${SUBJECT} (عادل محمد عدنان) at conferences, competitions, interviews and professional events in Iraq, Germany, China, Egypt and Cyprus.`}
  image={photos[0]?.file}
  imageAlt={photos[0]?.alt}
  imageWidth={photos[0]?.width}
  imageHeight={photos[0]?.height}
  jsonLd={gallery}
>
  <main>
    <h2>Photos of {SUBJECT}</h2>
    <p>
      {photos.length} photographs of {SUBJECT} (<span lang="ar">عادل محمد عدنان</span>)
      taken at conferences, competitions, workshops, interviews and award
      ceremonies between 2023 and 2026 — in Iraq, Germany, China, Egypt and
      Cyprus. Most were found online; a few are my own. Each photo has its own
      page with the date, the event and the original source.
    </p>
    <p>
      Last photo taken: <time datetime={lastUpdated}>{lastUpdatedText}</time>
    </p>

    <div class="full-screen-container">
      <div class="masonry-grid">
        {
          photos.map((photo, i) => (
            <figure class="grid-item">
              <a href={photo.url} aria-label={photo.alt}>
                <img
                  class="grid-item-img"
                  src={photo.thumb}
                  srcset={`${photo.thumb} 480w, ${photo.file} 1600w`}
                  sizes="(min-width: 1024px) 300px, (min-width: 768px) 33vw, 50vw"
                  alt={photo.alt}
                  title={photo.title}
                  width={photo.width}
                  height={photo.height}
                  loading={i < 6 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                />
              </a>
              <figcaption class="grid-item-caption">
                <a href={photo.url}>{photo.title}</a>
                {photo.takenISO && (
                  <span class="grid-item-date">
                    {" "}
                    <time datetime={photo.takenISO}>{photo.takenISO}</time>
                  </span>
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <Contact />
  </main>
  <style>
    body {
      overflow-x: hidden;
    }

    .full-screen-container {
      width: 100vw;
      margin-left: calc((100% - 100vw) / 2);
    }

    .masonry-grid {
      max-width: 1200px;
      margin: 0 auto;
    }

    .grid-item {
      width: 50%;
      margin: 0;
      padding: 0 4px 16px;
      box-sizing: border-box;
    }

    .grid-item-img {
      display: block;
      width: 100%;
      height: auto;
    }

    .grid-item-caption {
      font-size: 13px;
      line-height: 1.35;
      padding-top: 4px;
    }

    .grid-item-caption a {
      color: var(--font-color);
      text-decoration: none;
    }

    .grid-item-caption a:hover {
      text-decoration: underline;
      color: var(--link-color);
    }

    .grid-item-date {
      color: #666;
    }

    @media screen and (min-width: 768px) {
      .grid-item {
        width: 33.333%;
      }
    }

    @media screen and (min-width: 1024px) {
      .grid-item {
        width: 25%;
      }
    }
  </style>
  <script>
    import Masonry from "masonry-layout";

    const elem = document.querySelector(".masonry-grid");
    const msnry = new Masonry(elem!, {
      itemSelector: ".grid-item",
      columnWidth: ".grid-item",
      percentPosition: true,
    });

    document
      .querySelectorAll<HTMLImageElement>(".grid-item-img")
      .forEach((img) => {
        if (img.complete) msnry.layout?.();
        else img.addEventListener("load", () => msnry.layout?.());
      });
  </script>
</LayoutMinimal>
