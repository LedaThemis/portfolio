---
import LayoutMinimal from "../layouts/LayoutMinimal.astro";
import Contact from "../components/Contact.astro";
import { getPhotos, imageObject, SUBJECT } from "../lib/photos";

const photos = await getPhotos();

const lastUpdated = new Date("2026-03-07");
const lastUpdatedText = lastUpdated.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const years = photos.map((p) => p.takenISO?.slice(0, 4)).filter(Boolean).sort();
const ownWork = photos.filter(
  (p) => (p.reference_title ?? "Own work") === "Own work",
).length;

const stats = [
  ["Subject", "Adil Al Qaba"],
  ["Photos", String(photos.length)],
  ["Taken", `${years.at(0)}\u2013${years.at(-1)}`],
  ["Found online", String(photos.length - ownWork)],
  ["My own photos", String(ownWork)],
  ["Distinct sources", String(new Set(photos.map((p) => p.reference_title ?? "Own work")).size)],
  ["Linked to an event", String(photos.filter((p) => p.event).length)],
];

const gallery = {
  "@type": "ImageGallery",
  "@id": new URL("/photo-archive", Astro.site).toString() + "#gallery",
  url: new URL("/photo-archive", Astro.site).toString(),
  name: `Photos of ${SUBJECT}`,
  description: `Photographs of ${SUBJECT} at conferences, competitions, interviews and professional events.`,
  about: { "@id": "https://www.alqaba.com/#person" },
  numberOfItems: photos.length,
  associatedMedia: photos.map((p) => imageObject(p, Astro.site)),
};
---

<LayoutMinimal
  title="Photo Archive | Adil Al Qaba - Software Engineer"
  description="Photos of Adil Al Qaba (عادل محمد عدنان) at conferences, competitions, interviews, and professional events from around the internet."
  image={photos[0]?.file}
  imageAlt={photos[0]?.alt}
  imageWidth={photos[0]?.width}
  imageHeight={photos[0]?.height}
  jsonLd={gallery}
>
  <main>
    <h2>Photo Archive</h2>
    <p>A collection of photos I've found online from various events I've been part of. They're a fun (and slightly unsettling?) way to look back at some memorable moments and realize just how much of our lives is floating around out there on the internet. I'm curious about how search engines will treat this page and whether it will be discovered. I'm also hoping to develop this into something automated someday, it's a curiosity of mine!</p>
    <aside
      aria-label="Content warning"
      style="margin: 24px 0; padding: 10px; background-color: #ffcc00; border: 1px solid #cc9900;"
    >
      <strong>Warning for humans:</strong> This page contains many of my event appearances. You're about to see way too much of me! (Enter at your own risk!)
    </aside>
    <p>Last updated: <time datetime={lastUpdated.toISOString().split('T')[0]}>{lastUpdatedText}</time></p>
    <p class="italic">Tip: Hover over any image to see a description (or hold on phone)</p>

    <table class="stats">
      <caption class="sr-only">Summary of this photo archive</caption>
      <tbody>
        {stats.map(([label, value]) => (
          <tr>
            <th scope="row">{label}</th>
            <td>{value}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="full-screen-container">
      <div class="masonry-grid">
        {
          photos.map((photo, i) => (
            <figure class="grid-item">
              <a href={photo.url} aria-label={photo.alt}>
                <img
                  class="grid-item-img"
                  src={photo.thumb}
                  srcset={`${photo.thumb} 480w, ${photo.file} 1600w`}
                  sizes="(min-width: 1024px) 300px, (min-width: 768px) 33vw, 50vw"
                  alt={photo.alt}
                  title={photo.title}
                  width={photo.width}
                  height={photo.height}
                  loading={i < 6 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                />
              </a>
              <figcaption class="grid-item-caption">
                <a href={photo.url}>{photo.title}</a>
                {photo.takenISO && (
                  <span class="grid-item-date">
                    {" "}
                    <time datetime={photo.takenISO}>{photo.takenISO}</time>
                  </span>
                )}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <Contact />
  </main>
  <style>
    body {
      overflow-x: hidden;
    }

    .full-screen-container {
      width: 100vw;
      margin-left: calc((100% - 100vw) / 2);
    }

    .masonry-grid {
      max-width: 1200px;
      margin: 0 auto;
    }

    .grid-item {
      width: 50%;
      margin: 0;
      padding: 0 4px 16px;
      box-sizing: border-box;
    }

    .grid-item-img {
      display: block;
      width: 100%;
      height: auto;
    }

    .stats {
      border-collapse: collapse;
      margin: 24px 0;
      font-size: 15px;
    }

    .stats th,
    .stats td {
      text-align: left;
      padding: 4px 24px 4px 0;
      border-bottom: 1px solid #ddd;
    }

    .stats th {
      font-weight: 700;
      white-space: nowrap;
    }

    .grid-item-caption {
      font-size: 13px;
      line-height: 1.35;
      padding-top: 4px;
    }

    .grid-item-caption a {
      color: var(--font-color);
      text-decoration: none;
    }

    .grid-item-caption a:hover {
      text-decoration: underline;
      color: var(--link-color);
    }

    .grid-item-date {
      color: #666;
    }

    @media screen and (min-width: 768px) {
      .grid-item {
        width: 33.333%;
      }
    }

    @media screen and (min-width: 1024px) {
      .grid-item {
        width: 25%;
      }
    }
  </style>
  <script>
    import Masonry from "masonry-layout";

    const elem = document.querySelector(".masonry-grid");
    const msnry = new Masonry(elem!, {
      itemSelector: ".grid-item",
      columnWidth: ".grid-item",
      percentPosition: true,
    });

    document
      .querySelectorAll<HTMLImageElement>(".grid-item-img")
      .forEach((img) => {
        if (img.complete) msnry.layout?.();
        else img.addEventListener("load", () => msnry.layout?.());
      });
  </script>
</LayoutMinimal>
