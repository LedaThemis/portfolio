---
import LayoutMinimal from "../layouts/LayoutMinimal.astro";
import Contact from "../components/Contact.astro";
import { getCollection } from "astro:content";
import { getVideos } from "../lib/videos";

const press = await getCollection('press');
const videoPage = new Map((await getVideos()).map((v) => [v.slug, v]));
---

<LayoutMinimal
  title="Media mentions | Adil Al Qaba - Software Engineer"
  description="Media appearances of Adil Al Qaba (عادل محمد عدنان): interviews, TV features, and press mentions"
>
  <main>
    <h2>Media mentions</h2>
    <p>A complete list of media mentions where my work (or myself :grin:) is featured:</p>
    <!-- TODO: Consider using <blockquote> -->
    <ul>
      {press.map((entry) => (
        <li>
          <a href={entry.data.reference}>{entry.data.title}</a> {entry.data.mention && <span class="italic">(Mentioned as: <span lang={entry.data.mention.lang}>{entry.data.mention.text}</span>)</span>}
          {videoPage.has(entry.data.slug) && (
            <> — <a href={videoPage.get(entry.data.slug)!.url}>watch it here</a></>
          )}
        </li>
      ))}
    </ul>

    <Contact />
  </main>
</Layout>
